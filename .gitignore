# Unity project .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# --- Unity generated folders -------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# User specific editor state (window layouts, search index, last opened scene ...)
/[Uu]ser[Ss]ettings/

# Generated project settings that differ per machine / Unity install
/ProjectSettings/ShaderGraphSettings.asset
/ProjectSettings/MemorySettings.asset
/ProjectSettings/boot.config
/ProjectSettings/SceneTemplateSettings.json

# --- Meta files ---------------------------------------------------------------
# Asset meta data must be committed together with the asset (GUIDs!). It is only
# ignored when the corresponding asset is also ignored.
!/[Aa]ssets/**/*.meta

# --- Third party / IDE ---------------------------------------------------------
# Autogenerated JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / Rider
.vs/
.vscode/
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# --- Builds / signing ------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# Android signing keys must never be committed
*.keystore
*.jks

# Crashlytics generated file
crashlytics-build.properties

# --- OS junk -------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
*.swp
*.orig
